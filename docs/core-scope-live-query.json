  "plan": {
    "sql": "SELECT CAST(COUNT(CASE WHEN order_status = 'Complete' THEN 1 END) AS DOUBLE) / NULLIF(COUNT(*), 0) AS value FROM commerce.fct_orders WHERE order_date >= CAST('2026-09-01' AS DATE) AND order_date < CAST('2026-10-01' AS DATE) AND country = 'United States' AND gender = 'M' LIMIT 100",
